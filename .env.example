# ViewRA Environment Configuration

# Server Configuration
PORT=8080

# Database Configuration
# Options: "sqlite" (default) or "postgres"
DB_DRIVER=sqlite

# SQLite Configuration (used when DB_DRIVER=sqlite)
DB_PATH=data/viewra.db

# PostgreSQL Configuration (used when DB_DRIVER=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=viewra
# DB_PASSWORD=your_password_here
# DB_NAME=viewra
# DB_SSL_MODE=disable

# Media Configuration
# MEDIA_ROOT=/path/to/media

# Transcoding Configuration
# MAX_TRANSCODE_JOBS=2
# TRANSCODE_QUALITY=720p

# Security Configuration
# Global API rate limit (requests per minute per IP, default: 100)
# GLOBAL_RATE_LIMIT=600

# CORS Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# CORS_ALLOW_CREDENTIALS=true

# Development
# GIN_MODE=debug
# VIEWRA_DEV_MODE=1  # Enables pprof server on :6060 and auth bypass

# Frontend Configuration (used in web/ directory)
# VITE_API_BASE_URL=  # API base URL (defaults to '' for same-origin)
# VITE_UI_MODE=web    # UI mode: 'web' or 'tv'
